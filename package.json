{
  "name": "label-scraper",
  "version": "1.0.0",
  "description": "Generic, label-driven web extraction engine: give it a URL and a list of field labels, get structured JSON back.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "label-scraper": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
