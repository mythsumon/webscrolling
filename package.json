    "test": "node --test test/",
    "postinstall-browsers": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "robots-parser": "^3.0.1"
  },
  "license": "MIT"
}
