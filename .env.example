# Copy this file to `.env` and fill in what you need. `.env` is gitignored.
# Real environment variables always win over this file, so a deployment that
# sets them directly is unaffected.

# --- Google Places (the "Google Places" tab) -------------------------------
#
# Free allowance: Places API Text Search is a "Pro" SKU with 5,000 free
# events per month. Google moved off the old flat $200 monthly credit to
# per-SKU free caps, so 5,000 searches/month cost nothing — but a Google Cloud
# billing account (card on file) is still required to create a key at all.
# Past the free cap it is billed per 1,000 requests, so keep Max results low
# while experimenting: one search of 20 results is one event, but asking for
# 60 results is three.
#
# To get a key:
#   1. console.cloud.google.com -> create or pick a project
#   2. enable billing on that project
#   3. APIs & Services -> Library -> enable "Places API (New)"
#   4. APIs & Services -> Credentials -> Create credentials -> API key
#   5. Restrict the key: API restrictions -> Places API (New). For a server,
#      restrict by IP, not by HTTP referrer.
#
GOOGLE_MAPS_API_KEY=

# --- Optional: the AI fallback for labels the parsers miss -----------------
# Only used when you tick "Use the AI fallback", and only for labels that
# tiers 1-4 could not resolve.
ANTHROPIC_API_KEY=

# --- Optional: server tuning ----------------------------------------------
# PORT=3000
# MAX_CONCURRENT_SCRAPES=2
# RENDER_TIMEOUT_MS=30000
