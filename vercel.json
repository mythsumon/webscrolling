{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,

  "buildCommand": "echo \"no build step — public/ is served as-is\"",
  "outputDirectory": "public",

  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
